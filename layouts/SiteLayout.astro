---
import { assetHref, featuredGuide, homeHref, postHref } from '../lib/links';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'guide';
  coverImage?: string;
}

const { title, description, page, coverImage } = Astro.props;
const isArticle = Boolean(coverImage);
const canonical = Astro.site
  ? new URL(page === 'home' ? homeHref : Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = Astro.site && coverImage
  ? new URL(assetHref(coverImage), Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f5ee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {canonical && <meta property="og:url" content={canonical.href} />}
    {socialImage && <meta property="og:image" content={socialImage.href} />}
    <link rel="icon" href={assetHref('favicon.png')} type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={homeHref}><span class="brand-mark" aria-hidden="true">s</span>The Study Edit</a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={homeHref} aria-current={page === 'home' ? 'page' : undefined}>Home</a>
          <a href={postHref(featuredGuide)} aria-current={page === 'guide' ? 'page' : undefined}>The guide</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand" href={homeHref}><span class="brand-mark" aria-hidden="true">s</span>The Study Edit</a>
        <a href="#main-content">Back to top</a>
      </div>
    </footer>
  </body>
</html>
